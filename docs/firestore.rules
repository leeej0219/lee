rules_version = '2';
// Firebase 콘솔 > Firestore Database > 규칙(Rules) 탭에 이 내용을 그대로 붙여넣으세요.
//
// 동작 방식:
// - "볼트 코드"(vaultId)를 정확히 아는 사람만 그 볼트의 메모를 읽고 쓸 수 있습니다.
// - 볼트 목록 자체는 나열(list)할 수 없게 막아서, 코드를 모르면 다른 사람의 볼트를
//   찾아낼 방법이 없습니다. (코드는 충분히 길고 무작위라 추측하기 어렵습니다.)
// - 로그인 없이 동작하므로, 보안은 전적으로 "코드를 아는가"에 달려 있습니다.
//   코드는 비밀번호처럼 다루고 다른 사람과 공유하지 마세요.
service cloud.firestore {
  match /databases/{database}/documents {
    match /vaults/{vaultId} {
      allow get: if true;
      allow list: if false;

      match /notes/{noteId} {
        allow read, write: if true;
      }
    }
  }
}
